#!/bin/bash

## Description: Install a fresh site with Canvas, AI agents, and OAuth wired up
## Usage: site-install
## Example: ddev site-install

set -e

composer install

if [ ! -f keys/private.key ]; then
  echo "Generating OAuth key pair in keys/ ..."
  openssl genrsa -out keys/private.key 2048
  openssl rsa -in keys/private.key -pubout > keys/public.key
  chmod 600 keys/private.key
fi

drush site-install standard -y
drush recipe:apply "$(pwd)/recipes/canvas_starter" -y
drush cr

echo "Configuring Simple OAuth keys and the Canvas consumer ..."
drush config:set simple_oauth.settings public_key "$(pwd)/keys/public.key" -y
drush config:set simple_oauth.settings private_key "$(pwd)/keys/private.key" -y

# The canvas:media:{type}:create scopes (e.g. canvas:media:image:create,
# requested by default in `canvas login`) are created by this helper, only
# ever called from canvas_oauth's hook_install() -- which runs too early in
# the same recipe batch to see the Image media type. Re-run it directly.
drush php:eval "\Drupal::classResolver(\Drupal\canvas_oauth\MediaScopesHelper::class)->ensureMediaImageScopes();"

# A confidential client-credentials client for the Canvas CLI, so push/pull
# need no browser login. It acts as user 1 and may request every canvas:*
# scope. LOCAL DEVELOPMENT ONLY. The secret is set to a throwaway value here;
# the push-components/pull-components host commands rotate it to one they
# keep in canvas_components/.env (see canvas-common.sh).
drush php:eval "$(cat <<'PHP'
$etm = \Drupal::entityTypeManager();
$scopes = array_values(array_filter(
  array_keys($etm->getStorage('oauth2_scope')->loadMultiple()),
  fn ($id) => str_starts_with($id, 'canvas_'),
));
$storage = $etm->getStorage('consumer');
$existing = $storage->loadByProperties(['client_id' => 'canvas']);
$consumer = $existing ? reset($existing) : $storage->create(['client_id' => 'canvas']);
$consumer->set('label', 'Canvas CLI (local)');
$consumer->set('grant_types', ['client_credentials']);
$consumer->set('confidential', TRUE);
$consumer->set('pkce', FALSE);
$consumer->set('secret', bin2hex(random_bytes(32)));
$consumer->set('user_id', 1);
$consumer->set('scopes', $scopes);
$consumer->set('redirect', []);
$consumer->set('status', TRUE);
$consumer->save();
PHP
)"

# Export the result so config/sync/ is a valid baseline for `ddev build-local`
# (drush deploy refuses to import an empty sync directory).
drush config:export -y

echo ""
echo "Site installed. The Canvas consumer (client ID: canvas) is ready for 'ddev push-components'."
echo "Commit config/sync/ so teammates can use 'ddev build-local'."
echo ""
drush uli
